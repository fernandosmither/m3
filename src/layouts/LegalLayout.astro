---
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

interface Props {
  title: string;
  updated: string;
}
const { title, updated } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0c0d" />
    <title>{title} — M3</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch.png" />
  </head>
  <body>
    <main class="legal shell">
      <a class="legal__back" href="/">&larr; Back to M3</a>

      <header class="legal__head">
        <h1 class="legal__title">{title}.</h1>
        <p class="legal__updated">Last updated {updated}</p>
      </header>

      <article class="legal__body">
        <slot />
      </article>

      <footer class="legal__foot">
        <p>M3 is a collaboration between Constellation, Kairos and AISB.</p>
        <nav class="legal__nav" aria-label="Legal pages">
          <a href="/">Home</a>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Use</a>
        </nav>
      </footer>
    </main>
  </body>
</html>

<style>
  .legal {
    max-width: 44rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .legal__back {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .legal__back:hover {
    color: var(--ink);
  }

  .legal__head {
    margin-block: clamp(2rem, 5vw, 3rem) clamp(2.5rem, 6vw, 3.5rem);
  }

  .legal__title {
    font-size: var(--step-title);
  }

  .legal__updated {
    margin-block-start: 0.875rem;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .legal__body :global(h2) {
    margin-block: clamp(2rem, 4vw, 2.75rem) 0.875rem;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
  }

  .legal__body :global(p),
  .legal__body :global(li) {
    color: var(--ink-muted);
    line-height: 1.7;
  }

  .legal__body :global(p + p) {
    margin-block-start: 0.75rem;
  }

  .legal__body :global(ul) {
    margin-block: 0.75rem;
    padding-inline-start: 1.25rem;
  }

  .legal__body :global(li + li) {
    margin-block-start: 0.375rem;
  }

  .legal__body :global(a) {
    color: var(--ink);
  }

  .legal__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-block-start: clamp(3rem, 7vw, 4.5rem);
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--hairline-soft);
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .legal__foot p {
    margin: 0;
  }

  .legal__nav {
    display: flex;
    gap: 1.25rem;
  }

  .legal__nav a {
    color: inherit;
    text-decoration: none;
  }

  .legal__nav a:hover {
    color: var(--ink);
  }
</style>
