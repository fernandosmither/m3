---
/**
 * Promo banner, variant 1 — centered editorial print ad.
 *
 * A 1200×627 stage meant to be screenshotted for LinkedIn. Magazine
 * back-cover composition: mark, eyebrow, one big serif statement, a
 * disciplined stat row, quiet mono credits. Statement-led and symmetric.
 */
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../../styles/global.css";

import HeroBackdrop from "../../components/HeroBackdrop.astro";
import Grain from "../../components/Grain.astro";
import { stats } from "../../data/m3";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>Lab — promo ad 1</title>
  </head>
  <body>
    <div class="stage">
      <div class="stage__bg" aria-hidden="true">
        <!-- Nudged up so the constellation crowns just above the eyebrow and
             the tick fan textures the upper half, like the site hero. -->
        <div class="stage__constellation">
          <HeroBackdrop glowId="promo1-glow" />
        </div>
        <Grain filterId="promo1-grain" />
      </div>

      <div class="stage__content">
        <header class="masthead">
          <img class="masthead__mark" src="/icon.svg" alt="" width="46" height="46" />
          <p class="eyebrow masthead__eyebrow">M3 Fellowship</p>
        </header>

        <div class="statement">
          <h1 class="statement__title">Move into AI&nbsp;security.</h1>
          <p class="statement__sub">
            A three-month, salary-matched fellowship for senior security people.
            No mentors. You set the direction.
          </p>
        </div>

        <dl class="statrow">
          {stats.map((s) => (
            <div class="statrow__item">
              <dt class="statrow__value">{s.value}</dt>
              <dd class="statrow__unit">{s.unit}</dd>
            </div>
          ))}
        </dl>

        <footer class="credits">
          <p class="credits__apply">Apply by Aug 14 · m3fellowship.com</p>
          <p class="credits__orgs">Constellation · Kairos · AISB</p>
        </footer>
      </div>
    </div>
  </body>

  <style>
    html,
    body {
      margin: 0;
      overflow: hidden;
      background: var(--bg);
    }

    .stage {
      position: relative;
      isolation: isolate;
      width: 1200px;
      height: 627px;
      overflow: hidden;
      background: var(--bg);
    }

    .stage__bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .stage__constellation {
      position: absolute;
      inset: -90px 0 0 0;
    }

    .stage__content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      height: 100%;
      padding: 46px 56px 42px;
      text-align: center;
    }

    .masthead {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .masthead__mark {
      display: block;
      /* The tile is the same near-black as the page; a hairline gives it an
         edge without inventing a new treatment. */
      border: 1px solid var(--hairline);
      border-radius: 10px;
    }

    .masthead__eyebrow {
      font-size: 11px;
      color: var(--ink-faint);
    }

    .statement {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 22px;
      margin-block-start: 8px;
    }

    .statement__title {
      font-size: 92px;
      line-height: 1.05;
      letter-spacing: -0.014em;
    }

    .statement__sub {
      max-width: 48ch;
      color: var(--ink-muted);
      font-size: 20px;
      line-height: 1.55;
    }

    .statrow {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
      width: 100%;
      max-width: 820px;
      margin: 0;
      padding-block-start: 30px;
      border-block-start: 1px solid var(--hairline);
    }

    .statrow__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 9px;
    }

    .statrow__value {
      font-family: var(--serif);
      font-size: 44px;
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .statrow__unit {
      margin: 0;
      color: var(--ink-faint);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .credits {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 9px;
      font-family: var(--mono);
      text-transform: uppercase;
    }

    .credits__apply {
      color: var(--ink-muted);
      font-size: 12px;
      letter-spacing: 0.145em;
    }

    .credits__orgs {
      color: var(--ink-dim);
      font-size: 10px;
      letter-spacing: 0.17em;
    }
  </style>
</html>
