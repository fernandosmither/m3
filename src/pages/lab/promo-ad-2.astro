---
/**
 * Promo banner, variant 2 — asymmetric editorial spread.
 *
 * A 1200×627 stage meant to be screenshotted for LinkedIn. Left column
 * carries the offer in serif; a hairline stat rail dominates the right;
 * mono masthead and footer bar frame the page. Stats-led and off-axis:
 * the constellation rises from the bottom-right corner behind the rail.
 */
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../../styles/global.css";

import HeroBackdrop from "../../components/HeroBackdrop.astro";
import Grain from "../../components/Grain.astro";
import { stats } from "../../data/m3";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>Lab — promo ad 2</title>
  </head>
  <body>
    <div class="stage">
      <div class="stage__bg" aria-hidden="true">
        <!-- Constellation centre pushed to (1000, 700): the arcs fan up
             through the stat rail and thin out toward the copy. -->
        <div class="stage__constellation">
          <HeroBackdrop glowId="promo2-glow" />
        </div>
        <!-- Quiet the backdrop under the serif copy on the left. -->
        <div class="stage__scrim"></div>
        <Grain filterId="promo2-grain" />
      </div>

      <div class="stage__content">
        <header class="masthead">
          <div class="masthead__brand">
            <img class="masthead__mark" src="/icon.svg" alt="" width="38" height="38" />
            <p class="eyebrow masthead__eyebrow">A salary-matched fellowship</p>
          </div>
          <p class="eyebrow masthead__cta">Apply by Aug 14</p>
        </header>

        <div class="spread">
          <div class="spread__copy">
            <h1 class="spread__statement">
              A week in London to scope your project, then up to three paid
              months to work on&nbsp;it.
            </h1>
            <p class="spread__note">No mentors — you set the direction.</p>
          </div>

          <dl class="rail">
            {stats.map((s) => (
              <div class="rail__item">
                <dt class="rail__value">{s.value}</dt>
                <dd class="rail__unit">{s.unit}</dd>
              </div>
            ))}
          </dl>
        </div>

        <footer class="baseline">
          <p class="baseline__left">m3fellowship.com</p>
          <p class="baseline__right">Constellation · Kairos · AISB</p>
        </footer>
      </div>
    </div>
  </body>

  <style>
    html,
    body {
      margin: 0;
      overflow: hidden;
      background: var(--bg);
    }

    .stage {
      position: relative;
      isolation: isolate;
      width: 1200px;
      height: 627px;
      overflow: hidden;
      background: var(--bg);
    }

    .stage__bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .stage__constellation {
      position: absolute;
      top: 180px;
      left: 280px;
      width: 1440px;
      height: 794px;
    }

    .stage__scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        100deg,
        rgb(12 12 13 / 0.92) 0%,
        rgb(12 12 13 / 0.55) 44%,
        rgb(12 12 13 / 0) 72%
      );
    }

    .stage__content {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-rows: auto 1fr auto;
      height: 100%;
      padding: 44px 60px 38px;
    }

    .masthead {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .masthead__brand {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .masthead__mark {
      display: block;
      border: 1px solid var(--hairline);
      border-radius: 9px;
    }

    .masthead__eyebrow {
      font-size: 11px;
    }

    .masthead__cta {
      color: var(--ink-muted);
      font-size: 11px;
    }

    .spread {
      display: grid;
      grid-template-columns: 1fr 292px;
      column-gap: 72px;
      align-items: center;
      min-height: 0;
    }

    .spread__copy {
      display: flex;
      flex-direction: column;
      gap: 26px;
      padding-block-end: 8px;
    }

    .spread__statement {
      max-width: 15.5em;
      font-size: 49px;
      line-height: 1.16;
      letter-spacing: -0.01em;
    }

    .spread__note {
      color: var(--ink-faint);
      font-family: var(--mono);
      font-size: 11.5px;
      letter-spacing: 0.145em;
      text-transform: uppercase;
    }

    .rail {
      display: flex;
      flex-direction: column;
      align-self: stretch;
      justify-content: center;
      margin: 0;
      padding-inline-start: 40px;
      border-inline-start: 1px solid var(--hairline);
    }

    .rail__item {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-block: 21px;
    }

    .rail__item + .rail__item {
      border-block-start: 1px solid var(--hairline-soft);
    }

    .rail__value {
      font-family: var(--serif);
      font-size: 42px;
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .rail__unit {
      margin: 0;
      color: var(--ink-faint);
      font-family: var(--mono);
      font-size: 10.5px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .baseline {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      padding-block-start: 20px;
      border-block-start: 1px solid var(--hairline);
      font-family: var(--mono);
      font-size: 10.5px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .baseline__left {
      color: var(--ink-muted);
    }

    .baseline__right {
      color: var(--ink-dim);
    }
  </style>
</html>
