---
/**
 * Lab: promo banner, typographic poster no. 2 (cream inversion).
 *
 * The site's ink becomes the ground: warm cream #edebe6 with near-black type,
 * built to pop in a dark-mode feed. Three enormous serif lines are the image;
 * the mark and the facts sit quiet in the margins. One hairline.
 * Screenshot target: the .stage div at exactly 1200×627.
 */
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../../styles/global.css";

import Grain from "../../components/Grain.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex" />
    <title>Lab — promo type 2</title>
  </head>
  <body>
    <div class="stage">
      <header class="top">
        <!-- The M³ mark from public/icon.svg, tile dropped, recut in ink. -->
        <svg class="mark" viewBox="4.5 14 54.7 36" role="img" aria-label="M cubed">
          <g fill="#0c0c0d">
            <path d="M4.5 16 L17.5 16 L17.5 18.5 L14 18.5 L14 47.5 L17.5 47.5 L17.5 50 L4.5 50 L4.5 47.5 L8 47.5 L8 18.5 L4.5 18.5 Z"></path>
            <path d="M26.5 16 L39.5 16 L39.5 18.5 L36 18.5 L36 47.5 L39.5 47.5 L39.5 50 L26.5 50 L26.5 47.5 L30 47.5 L30 18.5 L26.5 18.5 Z"></path>
            <path d="M10.5 16 L16.5 16 L24.94 34.5 L32.4 16 L35 16 L23.5 44.5 Z"></path>
            <path d="M45 18.4 C46.2 15.6 48.8 14 51.6 14 C55.6 14 58.4 16.2 58.4 19.4 C58.4 21.9 56.9 23.4 54.4 24 C57.3 24.7 59.2 26.6 59.2 29 C59.2 32.2 56.4 34 52.8 34 C50 34 47.4 32.9 45.6 30.7 L47.8 29.1 C49.1 30.6 50.9 31.2 52.8 31.2 C54.9 31.2 56.2 30.4 56.2 29 C56.2 27.4 54.8 26.3 52.4 26.2 L50.4 26.2 L50.4 23.2 L52.2 23.2 C54.4 23.1 55.4 21.9 55.4 19.8 C55.4 17.8 53.8 16.8 51.6 16.8 C49.6 16.8 47.9 17.8 47.1 19.6 Z"></path>
          </g>
        </svg>
        <span class="top__url">m3fellowship.com</span>
      </header>

      <h1 class="headline">No&nbsp;mentors.<br />You set<br />the direction.</h1>

      <footer class="foot">
        <span class="foot__orgs">Constellation · Kairos · AISB</span>
        <span class="foot__cta">Apply by Aug 14</span>
      </footer>

      <Grain filterId="promo2-grain" opacity={0.07} />
    </div>
  </body>
  <style>
    html,
    body {
      overflow: hidden;
      background: #edebe6;
    }

    .stage {
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 1200px;
      height: 627px;
      overflow: hidden;
      padding: 46px 64px 0;
      background: #edebe6;
      color: #0c0c0d;
    }

    .top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .mark {
      display: block;
      width: 62px;
      height: 41px;
    }

    .top__url {
      font-family: var(--mono);
      font-size: 15px;
      letter-spacing: 0.08em;
      color: rgb(12 12 13 / 0.55);
    }

    .headline {
      /* Splits the leftover height evenly above and below the block. */
      margin-block: auto;
      font-size: 140px;
      line-height: 1.03;
      letter-spacing: -0.024em;
      color: #0c0c0d;
    }

    .foot {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-top: 1px solid rgb(12 12 13 / 0.16);
      padding: 20px 0 26px;
      font-family: var(--mono);
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .foot__orgs {
      color: rgb(12 12 13 / 0.55);
    }

    .foot__cta {
      color: #0c0c0d;
    }
  </style>
</html>
