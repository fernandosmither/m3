---
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Stats from "../components/Stats.astro";
import Timeline from "../components/Timeline.astro";
import Personas from "../components/Personas.astro";
import Problems from "../components/Problems.astro";
import Notes from "../components/Notes.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0c0d" />
    <title>M3 | A salary-matched fellowship for AI security</title>
    <link rel="canonical" href="https://m3fellowship.com/" />
    <meta
      name="description"
      content="A three-month, salary-matched fellowship for senior security people moving into AI security. A week in London to find the problem, then three paid months to work on it."
    />
  </head>
  <body>
    <Nav />
    <main>
      <div class="fold">
        <Hero />
        <Marquee />
      </div>
      <Stats />
      <Timeline />
      <Personas />
      <Problems />
      <Notes />
      <FAQ />
    </main>
    <Footer />
  <style>
    /* The first screen is a composition: the hero takes whatever the viewport
       gives it and the affiliations strip closes the fold, at every size. */
    .fold {
      display: grid;
      /* minmax(0, …) so the marquee's intrinsic track width can't blow the
         column out past the viewport. */
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      min-height: 100svh;
    }
  </style>
  </body>
</html>
