---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Statement from '../components/Statement.astro';
import Marquee from '../components/Marquee.astro';
---

<Base>
  <Nav />

  <!-- Statement and strip are centred together, so they read as one block. -->
  <main class="hero" id="main">
    <div class="hero__block">
      <Statement />
      <Marquee />
    </div>
  </main>
</Base>

<style>
  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* The scrim below bleeds past the viewport; clip it so nothing scrolls. */
    overflow: hidden;
  }

  .hero__block {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  /*
   * Soft pool of background colour behind the copy. It reaches well past the
   * text so the edge never reads as a shape, only as the ASCII thinning out.
   */
  .hero__block::before {
    content: '';
    position: absolute;
    inset: -18vh -10vw;
    z-index: -1;
    background: radial-gradient(
      ellipse 46% 50% at 50% 50%,
      var(--scrim-strong) 0%,
      var(--scrim-mid) 45%,
      var(--scrim-none) 78%
    );
  }
</style>
