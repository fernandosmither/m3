---
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import newsreaderWoff2 from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import plexMonoWoff2 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import { applyUrl } from "../data/m3";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "M3",
    alternateName: "M3 Fellowship",
    url: "https://m3fellowship.com/",
    logo: "https://m3fellowship.com/icon.svg",
    email: "fernando@m3fellowship.com",
    description:
      "A salary-matched fellowship for senior security people moving into AI security. A collaboration between Constellation, Kairos and AISB.",
  },
  {
    "@context": "https://schema.org",
    "@type": "JobPosting",
    title: "M3 Fellowship — AI security (salary-matched, part-time)",
    description:
      "<p>A three-month, salary-matched fellowship for senior security people moving into AI security. A week in person in London to scope your project, then a paid month of remote work alongside your job (about ten hours a week, at your rate up to $100 an hour), demo day on Oct 3, and a two-month financed extension for promising projects. No mentors — you set the direction. Six people per cohort. A collaboration between Constellation, Kairos and AISB.</p>",
    datePosted: "2026-08-09",
    validThrough: "2026-08-14T23:59:00-07:00",
    employmentType: ["TEMPORARY", "PART_TIME"],
    hiringOrganization: {
      "@type": "Organization",
      name: "M3",
      sameAs: "https://m3fellowship.com/",
      logo: "https://m3fellowship.com/icon.svg",
    },
    jobLocationType: "TELECOMMUTE",
    applicantLocationRequirements: { "@type": "Country", name: "Anywhere" },
    jobLocation: {
      "@type": "Place",
      address: { "@type": "PostalAddress", addressLocality: "London", addressCountry: "GB" },
    },
    baseSalary: {
      "@type": "MonetaryAmount",
      currency: "USD",
      value: { "@type": "QuantitativeValue", maxValue: 100, unitText: "HOUR" },
    },
    url: "https://m3fellowship.com/",
    directApply: false,
  },
];

import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Stats from "../components/Stats.astro";
import Timeline from "../components/Timeline.astro";
import Personas from "../components/Personas.astro";
import Problems from "../components/Problems.astro";
import Notes from "../components/Notes.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0c0d" />
    <title>M3 | A salary-matched fellowship for AI security</title>
    <link rel="canonical" href="https://m3fellowship.com/" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch.png" />
    <meta
      name="description"
      content="A three-month, salary-matched fellowship for senior security people moving into AI security. A week in London to find the problem, then three paid months to work on it."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="M3" />
    <meta property="og:url" content="https://m3fellowship.com/" />
    <meta property="og:title" content="M3 — Move into AI security" />
    <meta
      property="og:description"
      content="A salary-matched fellowship for senior security people. A week in London to scope your project, then up to three paid months to work on it."
    />
    <meta property="og:image" content="https://m3fellowship.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Move into AI security — a salary-matched fellowship by Constellation, Kairos and AISB"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="M3 — Move into AI security" />
    <meta
      name="twitter:description"
      content="A salary-matched fellowship for senior security people. A week in London to scope your project, then up to three paid months to work on it."
    />
    <meta name="twitter:image" content="https://m3fellowship.com/og.png" />
    <link rel="preload" href={newsreaderWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMonoWoff2} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- PostHog, cookieless: in-memory persistence only, no cookies or local
         storage, IP discard enabled project-side — per our privacy policy. -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init("phc_p93wH4bLiqu5NUpD2HCKkUDY9r8Z8RJj8C7vtFYFz9Zb", {
        api_host: "https://m3fellowship.com/arc",
        ui_host: "https://us.posthog.com",
        persistence: "memory",
      });
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <div class="fold">
        <Hero />
        <Marquee />
      </div>
      <Stats />
      <Timeline />
      <Personas />
      <Problems />
      <Notes />
      <FAQ />
    </main>
    <Footer />
  <style>
    /* The first screen is a composition: the hero takes whatever the viewport
       gives it and the affiliations strip closes the fold, at every size. */
    .fold {
      display: grid;
      /* minmax(0, …) so the marquee's intrinsic track width can't blow the
         column out past the viewport. */
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      min-height: 100svh;
    }
  </style>
  </body>
</html>
