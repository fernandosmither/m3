---
import "@fontsource-variable/newsreader";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Stats from "../components/Stats.astro";
import PhasesReview from "../components/PhasesReview.astro";
import Personas from "../components/Personas.astro";
import Problems from "../components/Problems.astro";
import Notes from "../components/Notes.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0c0d" />
    <title>M3 — A salary-matched fellowship for AI security</title>
    <meta
      name="description"
      content="A three-month, salary-matched fellowship for senior security people moving into AI security. A week in London to find the problem, then three paid months to work on it."
    />
  </head>
  <!-- TEMPORARY: lets ?p=1..5 preview phase treatments. Remove once one is chosen. -->
  <script is:inline>
    const p = new URLSearchParams(location.search).get("p");
    if (p) document.documentElement.dataset.phases = p;
  </script>
  <body>
    <Nav />
    <main>
      <Hero />
      <Marquee />
      <Stats />
      <PhasesReview />
      <Personas />
      <Problems />
      <Notes />
      <FAQ />
    </main>
    <Footer />
  </body>
</html>
