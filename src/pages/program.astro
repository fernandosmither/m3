---
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import Rows from '../components/Rows.astro';
import { program } from '../data/site';
---

<Base title={program.title} ascii={0}>
  <Panel eyebrow={program.eyebrow} headline={program.headline} />

  <main id="main">
    <dl class="stats">
      {
        program.stats.map((s) => (
          <div class="stat">
            <dt class="stat__value">{s.value}</dt>
            <dd class="stat__unit">{s.unit}</dd>
          </div>
        ))
      }
    </dl>

    <Rows sections={program.sections} />
  </main>
</Base>

<style>
  /*
   * Two columns on phones, four on desktop. Each figure is centred over its
   * unit; with widths as different as "3" and "10-40", left alignment left the
   * block ragged.
   */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 5vw, 2.5rem) clamp(1rem, 4vw, 3rem);
    padding: clamp(2.5rem, 6vw, 4rem) var(--gutter);
    border-bottom: 1px solid var(--c4);
    text-align: center;
  }

  .stat__value {
    font-family: var(--font-sans);
    font-size: var(--display);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c1);
  }

  .stat__unit {
    margin-top: 0.45em;
    font-family: var(--font-mono);
    font-size: var(--statement);
    color: var(--c3);
    /* Keeps "people, first cohort" from breaking mid-word. */
    text-wrap: balance;
  }

  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
