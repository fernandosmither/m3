---
interface Props {
  /** Background intensity from 0 to 1. */
  intensity?: number;
  /** plasma | rain | tunnel | bars | life */
  variant?: string;
}

const { intensity = 1, variant = 'plasma' } = Astro.props;

const BANDS = [
  { tone: 'var(--ascii-1)', op: 1 },
  { tone: 'var(--ascii-2)', op: 1 },
  { tone: 'var(--ascii-3)', op: 0.75 },
  { tone: 'var(--ascii-4)', op: 0.9 },
];
---

<div class="ascii" aria-hidden="true" data-variant={variant} style={`--intensity:${intensity}`}>
  {
    BANDS.map((b, i) => (
      <pre class="ascii__layer" data-band={i} style={`color:${b.tone};opacity:${b.op}`} />
    ))
  }
  <span class="ascii__probe">M</span>
</div>

<script>
  const BANDS = ['.:', '-=', '+*', '#%'];
  const CUTS = [0.44, 0.58, 0.7, 0.81];
  const FRAME_MS = 60; // ~16fps
  /** Radio en celdas de la onda que sigue al mouse. */
  const POINTER_R = 20;

  type Ctx = { cols: number; rows: number; cx: number; cy: number };

  /**
   * Cada generador devuelve 0–1 por celda. `yy` es la Y compensada por la
   * proporción de celda (~1:1.8), para que los círculos salgan redondos.
   */
  const FIELDS: Record<string, (x: number, yy: number, t: number, c: Ctx) => number> = {
    // Suma de senos más una onda radial: nubes que respiran.
    plasma(x, yy, t, c) {
      const dx = x - c.cx;
      const dy = yy - c.cy * 1.8;
      const n =
        (Math.sin(x * 0.11 + t) +
          Math.sin(yy * 0.09 - t * 0.6) +
          Math.sin((x + yy) * 0.05 + t * 1.1) +
          Math.sin(Math.sqrt(dx * dx + dy * dy) * 0.13 - t * 1.4)) /
        4;
      return (n + 1) / 2;
    },

    // Columnas que caen a distinta velocidad, con cabeza brillante y estela.
    rain(x, yy, t) {
      const seed = Math.sin(x * 12.9898) * 43758.5453;
      const phase = seed - Math.floor(seed); // 0–1 estable por columna
      const speed = 6 + phase * 22;
      const head = ((t * speed + phase * 400) % 90) - 20;
      const d = yy / 1.8 - head;
      if (d < 0 || d > 26) return 0;
      // La cabeza va llena y la estela se apaga.
      return 1 - d / 26;
    },

    // Anillos concéntricos que se abren desde el centro.
    tunnel(x, yy, t, c) {
      const dx = x - c.cx;
      const dy = yy - c.cy * 1.8;
      const r = Math.sqrt(dx * dx + dy * dy);
      const a = Math.atan2(dy, dx);
      const rings = Math.sin(r * 0.22 - t * 3);
      const spokes = Math.sin(a * 6 + t * 0.8) * 0.35;
      return (rings + spokes + 1.35) / 2.7;
    },

    // Horizontally drifting bands.
    bars(x, yy, t) {
      const row = Math.floor(yy / 1.8);
      const seed = Math.sin(row * 78.233) * 43758.5453;
      const jitter = seed - Math.floor(seed);
      const drift = t * (8 + jitter * 10) * (row % 2 ? 1 : -1);
      const band = Math.sin((x + drift) * 0.06 + row * 0.9);
      const envelope = Math.sin(row * 0.14 - t * 0.5);
      return (band * 0.55 + envelope * 0.45 + 1) / 2;
    },
  };

  const field = document.querySelector<HTMLElement>('.ascii');
  if (field) {
    const layers = [...field.querySelectorAll<HTMLElement>('.ascii__layer')];
    const probe = field.querySelector<HTMLElement>('.ascii__probe')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let variant = field.dataset.variant || 'plasma';
    let cols = 0;
    let rows = 0;
    let cellW = 7.2;
    let cellH = 13;
    let last = 0;
    let raf = 0;

    // Estado del juego de la vida; se reinicia al cambiar de tamaño o variante.
    let life: Uint8Array | null = null;
    let lifeStep = 0;

    // Puntero en coordenadas de celda. `to` es donde está, `at` lo persigue
    // con easing para que la onda no salte de un cuadro al siguiente.
    const to = { x: -999, y: -999 };
    const at = { x: -999, y: -999 };
    let pointer = 0; // 0–1: cuánto pesa la onda del mouse
    let target = 0; // a dónde tiende pointer: 1 con el mouse dentro, 0 fuera

    const measure = () => {
      const box = probe.getBoundingClientRect();
      cellW = box.width || 7.2;
      cellH = box.height || 13;
      cols = Math.ceil(window.innerWidth / cellW) + 1;
      rows = Math.ceil(window.innerHeight / cellH) + 1;
      life = null;
    };

    /** Vida: siembra aleatoria y un paso de Conway por cuadro. */
    const stepLife = () => {
      if (!life) {
        life = new Uint8Array(cols * rows);
        for (let i = 0; i < life.length; i++) life[i] = Math.random() < 0.22 ? 1 : 0;
        lifeStep = 0;
      }
      const next = new Uint8Array(cols * rows);
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          let n = 0;
          for (let dy = -1; dy <= 1; dy++) {
            for (let dx = -1; dx <= 1; dx++) {
              if (!dx && !dy) continue;
              // Toro: los bordes se pegan, así nada muere por el marco.
              const yy = (y + dy + rows) % rows;
              const xx = (x + dx + cols) % cols;
              n += life[yy * cols + xx];
            }
          }
          const alive = life[y * cols + x];
          next[y * cols + x] = n === 3 || (alive && n === 2) ? 1 : 0;
        }
      }
      life = next;
      // Cada tanto vuelve a sembrar, si no el tablero se estanca.
      if (++lifeStep > 260) life = null;
    };

    const paint = (t: number) => {
      const gen = FIELDS[variant];
      const isLife = variant === 'life';
      if (isLife) stepLife();

      const ctx = { cols, rows, cx: cols / 2, cy: rows / 2 };
      const out = BANDS.map(() => '');

      const px = at.x;
      const py = at.y;
      const live = pointer > 0.01;

      for (let y = 0; y < rows; y++) {
        const yy = y * 1.8;
        const py2 = (y - py) * 1.8;
        for (let x = 0; x < cols; x++) {
          let v: number;

          if (isLife) {
            // Densidad = celda viva más cuántas vecinas vivas tiene, para que
            // los cúmulos salgan más brillantes que las células sueltas.
            const i = y * cols + x;
            if (!life![i]) {
              v = 0;
            } else {
              let n = 0;
              for (let dy = -1; dy <= 1; dy++)
                for (let dx = -1; dx <= 1; dx++) {
                  if (!dx && !dy) continue;
                  n += life![((y + dy + rows) % rows) * cols + ((x + dx + cols) % cols)];
                }
              v = 0.5 + n / 12;
            }
          } else {
            v = gen(x, yy, t, ctx);
          }

          if (live) {
            const mx = x - px;
            const md = Math.sqrt(mx * mx + py2 * py2);
            if (md < POINTER_R * 2) {
              // Anillo que se abre desde el cursor y se apaga con la distancia.
              const falloff = Math.exp(-md / POINTER_R);
              v += Math.sin(md * 0.34 - t * 9) * falloff * 0.42 * pointer;
            }
          }

          // Banda a la que cae esta celda: -1 = vacía.
          let band = -1;
          for (let k = CUTS.length - 1; k >= 0; k--) {
            if (v >= CUTS[k]) {
              band = k;
              break;
            }
          }

          for (let k = 0; k < BANDS.length; k++) {
            if (k !== band) {
              out[k] += ' ';
              continue;
            }
            const hi = CUTS[k + 1] ?? 1;
            out[k] += BANDS[k][v > (CUTS[k] + hi) / 2 ? 1 : 0];
          }
        }
        for (let k = 0; k < out.length; k++) out[k] += '\n';
      }

      for (let k = 0; k < layers.length; k++) layers[k].textContent = out[k];
    };

    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      if (now - last < FRAME_MS) return;
      last = now;

      // El cursor se persigue con easing; `pointer` sube al entrar y baja al salir.
      at.x += (to.x - at.x) * 0.18;
      at.y += (to.y - at.y) * 0.18;
      pointer += (target - pointer) * 0.12;

      paint(now / 2600);
    };

    measure();
    paint(0);
    if (!still) raf = requestAnimationFrame(loop);

    // Interaccion con el mouse. Solo en punteros finos: en tactil no hay
    // hover y la onda quedaria pegada donde toco la ultima vez.
    if (!still && matchMedia('(pointer: fine)').matches) {
      window.addEventListener(
        'pointermove',
        (e) => {
          to.x = e.clientX / cellW;
          to.y = e.clientY / cellH;
          if (at.x < -100) {
            // Primer movimiento: aparece donde esta el cursor, sin barrido.
            at.x = to.x;
            at.y = to.y;
          }
          target = 1;
        },
        { passive: true }
      );

      document.addEventListener('pointerleave', () => {
        target = 0;
      });
    }

    // Allow the generator to be changed at runtime.
    window.addEventListener('ascii:variant', (e) => {
      variant = (e as CustomEvent<string>).detail;
      field.dataset.variant = variant;
      life = null;
      if (still) paint(0);
    });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        measure();
        if (still) paint(0);
      }, 150);
    });

    // Sin gasto de CPU con la pestaña escondida.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
        raf = 0;
      } else if (!still && !raf) {
        raf = requestAnimationFrame(loop);
      }
    });
  }
</script>

<style>
  .ascii {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    opacity: var(--intensity, 1);
    /* El centro se aclara para que el texto de encima siempre gane. */
    -webkit-mask-image: radial-gradient(
      ellipse 62% 46% at 50% 50%,
      rgba(0, 0, 0, 0.14) 0%,
      rgba(0, 0, 0, 0.55) 44%,
      #000 80%
    );
    mask-image: radial-gradient(
      ellipse 62% 46% at 50% 50%,
      rgba(0, 0, 0, 0.14) 0%,
      rgba(0, 0, 0, 0.55) 44%,
      #000 80%
    );
  }

  .ascii__layer {
    position: absolute;
    inset: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 13px;
    white-space: pre;
    overflow: hidden;
  }

  /* Mide el ancho real de celda; nunca se ve. */
  .ascii__probe {
    position: absolute;
    top: -100vh;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 13px;
    white-space: pre;
  }

  @media (max-width: 640px) {
    .ascii__layer,
    .ascii__probe {
      font-size: 10px;
      line-height: 11px;
    }
  }
</style>
