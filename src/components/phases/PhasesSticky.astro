---
import { phases } from "../../data/m3";
---

<div class="sticky shell">
  {phases.map((phase) => (
    <section class="sticky__row">
      <header class="sticky__head">
        <p class="sticky__index">({phase.index})</p>
        <h3 class="sticky__title">{phase.title}</h3>
      </header>
      <div class="sticky__body">
        {phase.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>
  ))}
</div>

<style>
  .sticky__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding-block: clamp(2rem, 5vw, 3.25rem);
    border-block-start: 1px solid var(--hairline);
  }

  .sticky__index {
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
  }

  .sticky__title {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
  }

  .sticky__body {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    color: var(--ink-muted);
    line-height: 1.66;
  }

  @media (min-width: 52rem) {
    .sticky__row {
      grid-template-columns: 18rem minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4rem);
    }

    /* The title parks under the fixed nav while its paragraphs scroll past. */
    .sticky__head {
      position: sticky;
      inset-block-start: clamp(5.5rem, 12vh, 7rem);
      align-self: start;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    .sticky__body {
      max-width: 42rem;
    }
  }
</style>
