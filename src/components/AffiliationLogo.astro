---
interface Props {
  name: string;
  file: string;
}

const { name, file } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---

<img
  class="logo"
  src={`${base}/logos/${file}`}
  alt={name}
  decoding="async"
/>

<style>
  .logo {
    display: block;
    height: clamp(1.5rem, 1.2rem + 1vw, 1.9rem);
    width: auto;
    max-width: 9.5rem;
    object-fit: contain;
    /* The source marks are dark-on-transparent; this renders them flat white. */
    filter: brightness(0) invert(1);
    opacity: 0.55;
  }
</style>
