---
/**
 * TEMPORARY review harness: renders all five phase treatments and shows one,
 * selected with ?p=1..5. Once one is chosen, keep that component and delete
 * this file.
 */
import PhasesCards from "./phases/PhasesCards.astro";
import PhasesAccordion from "./phases/PhasesAccordion.astro";
import PhasesSticky from "./phases/PhasesSticky.astro";
import PhasesTabs from "./phases/PhasesTabs.astro";
import PhasesSpread from "./phases/PhasesSpread.astro";
import Grain from "./Grain.astro";

const variants = [
  { id: 1, name: "Cards", Component: PhasesCards },
  { id: 2, name: "Accordion", Component: PhasesAccordion },
  { id: 3, name: "Sticky split", Component: PhasesSticky },
  { id: 4, name: "Tabs", Component: PhasesTabs },
  { id: 5, name: "Editorial spread", Component: PhasesSpread },
];
---

<section class="phases" id="program" aria-labelledby="program-heading">
  <div class="phases__bg" aria-hidden="true">
    <Grain filterId="phases-grain-filter" />
  </div>

  <h2 class="visually-hidden" id="program-heading">Program</h2>

  {variants.map(({ id, Component }) => (
    <div class="phases__variant" data-phases-variant={id}>
      <Component />
    </div>
  ))}
</section>

<style>
  .phases {
    position: relative;
    isolation: isolate;
    border-block-start: 1px solid var(--hairline-soft);
    padding-block: clamp(3rem, 8vw, 5.5rem);
    background: var(--bg);
    overflow: hidden;
  }

  .phases__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Default view is variant 1; ?p= swaps it. */
  .phases__variant {
    position: relative;
    z-index: 1;
    display: none;
  }

  .phases__variant[data-phases-variant="1"] {
    display: block;
  }

  :global(html[data-phases="1"]) .phases__variant[data-phases-variant="1"],
  :global(html[data-phases="2"]) .phases__variant[data-phases-variant="2"],
  :global(html[data-phases="3"]) .phases__variant[data-phases-variant="3"],
  :global(html[data-phases="4"]) .phases__variant[data-phases-variant="4"],
  :global(html[data-phases="5"]) .phases__variant[data-phases-variant="5"] {
    display: block;
  }

  :global(html[data-phases="2"]) .phases__variant[data-phases-variant="1"],
  :global(html[data-phases="3"]) .phases__variant[data-phases-variant="1"],
  :global(html[data-phases="4"]) .phases__variant[data-phases-variant="1"],
  :global(html[data-phases="5"]) .phases__variant[data-phases-variant="1"] {
    display: none;
  }
</style>
