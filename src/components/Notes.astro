---
import { notes } from "../data/m3";
---

<section class="notes" id="scope" aria-labelledby="scope-heading">
  <div class="shell">
    <h2 class="visually-hidden" id="scope-heading">Scope</h2>

    <div class="notes__grid">
      {notes.map((note) => (
        <article class="note">
          <p class="note__index">({note.index})</p>
          <h3 class="note__title">{note.title}</h3>
          {note.paragraphs.map((p) => (
            <p class="note__text">{p}</p>
          ))}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .notes {
    border-block-start: 1px solid var(--hairline-soft);
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }

  .notes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: clamp(2.25rem, 5vw, 4rem);
  }

  .note {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .note__index {
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
  }

  .note__title {
    margin-block-end: 0.375rem;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
  }

  .note__text {
    color: var(--ink-muted);
    line-height: 1.66;
  }
</style>
