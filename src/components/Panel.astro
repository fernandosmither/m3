---
import Nav from './Nav.astro';

interface Props {
  /** 'dark', or a palette role: c1..c5. */
  tone?: string;
  eyebrow: string;
  headline: string;
}

const { tone = 'dark', eyebrow, headline } = Astro.props;
const light = tone !== 'dark';
---

<section
  class:list={['panel', light && 'panel--light']}
  style={light ? `--panel: var(--${tone})` : undefined}
>
  <Nav />
  <div class="panel__body">
    <p class="panel__eyebrow" data-rise style="--delay: 0.1s">{eyebrow}</p>
    <h1 class="panel__headline" data-rise style="--delay: 0.16s">{headline}</h1>
  </div>
</section>

<style>
  .panel {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 72svh;
    background: var(--black);
    color: var(--ink);
  }

  .panel--light {
    background: var(--panel);
    color: var(--on-light);
  }

  .panel__body {
    flex: 1;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    padding: clamp(3rem, 8vw, 6rem) var(--gutter);
    text-align: center;
  }

  .panel__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--statement);
    letter-spacing: 0.06em;
  }

  .panel--light .panel__eyebrow {
    color: inherit;
  }

  /* On dark, the label takes the accent: the only colour above the fold. */
  .panel:not(.panel--light) .panel__eyebrow {
    color: var(--c2);
  }

  /* On mobile 72svh left a large dead gap before the content. */
  @media (max-width: 640px) {
    .panel {
      min-height: 56svh;
    }

    .panel__body {
      padding-block: clamp(2rem, 8vw, 3rem);
    }
  }

  .panel__headline {
    max-width: 20ch;
    font-family: var(--font-sans);
    font-size: var(--display);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
</style>
