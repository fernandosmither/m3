---
import { timeline } from "../data/m3";
---

<section class="timeline" id="program" aria-labelledby="program-heading">
  <div class="shell timeline__inner">
    <p class="eyebrow" id="program-heading">Timeline</p>

    <ol class="flow">
      {timeline.map((stop) => (
        <li class="stop">
          <h3 class="stop__head">
            <span class="stop__name">{stop.title}</span>
            <span class="stop__when">{stop.when}</span>
          </h3>
          <p class="stop__body">{stop.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Flat band like Personas/Notes — no grain — so it reads as its own
     section against the grain-backed lede above. */
  .timeline {
    border-block-start: 1px solid var(--hairline-soft);
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }

  .timeline__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2.25rem, 5vw, 3.5rem);
  }

  .flow {
    --flow-gap: clamp(2.75rem, 5vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--flow-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stop {
    position: relative;
  }

  /* The long arrow between stops, sitting in the column gap on the
     title line. */
  .stop + .stop::before {
    content: "⟶";
    position: absolute;
    top: 0.1em;
    left: calc(var(--flow-gap) / -2);
    transform: translateX(-50%);
    color: var(--ink-dim);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.3;
  }

  .stop__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stop__name {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .stop__when {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .stop__body {
    margin-block-start: 0.875rem;
    color: var(--ink-muted);
    line-height: 1.66;
  }

  /* Below 64rem the row would cramp: stack the stops and turn the
     arrows downward. */
  @media (max-width: 64rem) {
    .flow {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .stop + .stop::before {
      position: static;
      display: block;
      width: max-content;
      margin: 0 auto 1.25rem;
      transform: rotate(90deg);
    }
  }
</style>
