---
import { lead, stats, timeline } from "../data/m3";
import Grain from "./Grain.astro";
---

<section class="program" id="program" aria-labelledby="program-heading">
  <div class="program__bg" aria-hidden="true">
    <Grain filterId="program-grain-filter" />
  </div>

  <div class="shell program__inner">
    <div class="program__lede">
      <h2 class="program__lead" id="program-heading">{lead}</h2>

      <dl class="stats">
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat__value">{s.value}</dt>
            <dd class="stat__unit">{s.unit}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="program__flow">
      <p class="eyebrow">Timeline</p>

      <ol class="flow">
        {timeline.map((stop) => (
          <li class="stop">
            <h3 class="stop__head">
              <span class="stop__name">{stop.title}</span>
              <span class="stop__when">{stop.when}</span>
            </h3>
            <p class="stop__body">{stop.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .program {
    position: relative;
    isolation: isolate;
    border-block-start: 1px solid var(--hairline-soft);
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
    background: var(--bg);
    overflow: hidden;
  }

  .program__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .program__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 8vw, 5.5rem);
  }

  .program__lede {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }

  .program__lead {
    max-width: 24ch;
    font-size: var(--step-lead);
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -0.008em;
  }

  .stats {
    display: grid;
    /* Explicit 2-up then 4-up. auto-fit would sometimes resolve to three
       columns and leave the fourth stat orphaned on its own row. */
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.75rem, 4vw, 2.5rem);
    width: 100%;
    max-width: 52rem;
    margin: 0;
  }

  @media (min-width: 46rem) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .stat__value {
    font-family: var(--serif);
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat__unit {
    margin: 0;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .program__flow {
    display: flex;
    flex-direction: column;
    gap: clamp(2.25rem, 5vw, 3.5rem);
  }

  .flow {
    --flow-gap: clamp(2.75rem, 5vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--flow-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stop {
    position: relative;
  }

  /* The long arrow between stops, sitting in the column gap on the
     title line. */
  .stop + .stop::before {
    content: "⟶";
    position: absolute;
    top: 0.1em;
    left: calc(var(--flow-gap) / -2);
    transform: translateX(-50%);
    color: var(--ink-dim);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.3;
  }

  .stop__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stop__name {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .stop__when {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .stop__body {
    margin-block-start: 0.875rem;
    color: var(--ink-muted);
    line-height: 1.66;
  }

  /* Below 64rem the row would cramp: stack the stops and turn the
     arrows downward. */
  @media (max-width: 64rem) {
    .flow {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .stop + .stop::before {
      position: static;
      display: block;
      width: max-content;
      margin: 0 auto 1.25rem;
      transform: rotate(90deg);
    }
  }
</style>
