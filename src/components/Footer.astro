---
import { legal, emailDisplay, site } from '../data/site';
---

<footer class="footer" data-rise style="--delay: 0.24s">
  <p class="footer__legal">
    {
      legal.map((part) =>
        part.href ? (
          <a href={part.href} target="_blank" rel="noopener">
            {part.text}
          </a>
        ) : (
          part.text
        )
      )
    }
  </p>
  <a class="footer__mail" href={`mailto:${site.email}`}>{emailDisplay}</a>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
    padding: var(--gutter);
    /* Mirror of the nav scrim, fading upward. */
    background: linear-gradient(
      0deg,
      var(--scrim-strong) 0%,
      var(--scrim-mid) 55%,
      var(--scrim-none) 100%
    );
    padding-top: calc(var(--gutter) * 2);
    color: var(--c1);
    font-family: var(--font-mono);
    font-size: var(--footer-text);
    letter-spacing: 0.01em;
  }

  .footer__legal a {
    color: var(--c3);
    transition: color 0.25s var(--ease);
  }

  .footer__legal a:hover {
    color: var(--c1);
  }

  .footer__mail {
    transition: opacity 0.25s var(--ease);
  }

  .footer__mail:hover {
    opacity: 0.65;
  }

  /*
   * On phones the credit no longer fits beside the email, so both stack and
   * the type drops a step to keep the line count down.
   */
  @media (max-width: 640px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
      font-size: 0.6875rem;
      letter-spacing: 0;
    }
  }
</style>
