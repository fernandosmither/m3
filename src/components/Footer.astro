---
import Grain from "./Grain.astro";
import { footer } from "../data/m3";
---

<footer class="footer" id="apply">
  <div class="footer__shell">
    <div class="panel">
      <div class="panel__bg" aria-hidden="true">
        <Grain filterId="footer-grain-filter" />
      </div>

      <div class="panel__content">
        <h2 class="panel__title">{footer.headline}</h2>

        <a class="apply" href={footer.ctaHref}>{footer.ctaLabel}</a>
      </div>
    </div>

    <div class="colophon">
      <p class="colophon__legal">
        {footer.legalPrefix + " "}
        {footer.orgs.map((org, i) => (
          <>
            <a class="colophon__link" href={org.href} rel="noopener">{org.name}</a>{i < footer.orgs.length - 2 ? ", " : i === footer.orgs.length - 2 ? " and " : ""}
          </>
        ))}
      </p>
      <nav class="colophon__nav" aria-label="Legal">
        {footer.legalLinks.map((link) => (
          <a class="colophon__link" href={link.href}>{link.label}</a>
        ))}
        <a class="colophon__link" href={`mailto:${footer.email}`}>{footer.email}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(0.75rem, 1.5vw, 1rem);
  }

  /* Wider than the article measure so the panel reads as a base for the page,
     but still inset from the viewport edge rather than full-bleed. */
  .footer__shell {
    width: 100%;
    max-width: 88rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 3.5vw, 2.75rem);
  }

  .panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: clamp(0.75rem, 1.2vw, 1rem);
    background: #0c0c0d;
  }

  .panel__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .panel__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.875rem, 1.8vw, 1.125rem);
    padding: clamp(1.75rem, 4vw, 2.5rem) clamp(1rem, 4vw, 2rem);
    text-align: center;
  }

  .panel__title {
    /* Wide enough to stay on one line wherever it fits; `balance` only kicks
       in once it genuinely has to wrap. */
    max-width: 42ch;
    font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.375rem);
  }

  .apply {
    padding: 0.6875rem 1.5rem;
    border: 0;
    border-radius: 0.4375rem;
    background: #e9e7e2;
    color: #0c0c0d;
    font-family: var(--mono);
    font-size: 0.71875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .apply:hover {
    background: #fff;
    transform: translateY(-1px);
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.375rem 1.5rem;
    padding: clamp(0.75rem, 1.6vw, 1rem) clamp(0.25rem, 1vw, 0.75rem) 0;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .colophon__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
  }

  .colophon__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .colophon__link:hover {
    color: var(--ink);
  }

  @media (max-width: 40rem) {
    .colophon {
      justify-content: center;
      text-align: center;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .apply,
    .colophon__link {
      transition: none;
    }
  }
</style>
