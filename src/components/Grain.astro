---
/**
 * Full-bleed film grain.
 *
 * feTurbulence is generated by the browser, so this costs no image request and
 * stays sharp at any DPR. It is painted once over the whole page and never
 * animates, which keeps it off the compositor's hot path.
 */
interface Props {
  /** Turbulence frequency; higher is finer grain. */
  frequency?: number;
  opacity?: number;
  filterId?: string;
}
// Kept low on purpose: feTurbulence emits mid-grey noise, and `overlay` over a
// near-black base lifts the blacks fast. Above ~0.2 the background reads grey
// rather than black-with-grain.
const { frequency = 0.85, opacity = 0.13, filterId = "grain-filter" } = Astro.props;
---

<svg class="grain" aria-hidden="true" focusable="false" style={`--grain-opacity:${opacity}`}>
  <filter id={filterId}>
    <feTurbulence
      type="fractalNoise"
      baseFrequency={frequency}
      numOctaves="3"
      stitchTiles="stitch"
    />
    <feColorMatrix type="saturate" values="0" />
  </filter>
  <rect width="100%" height="100%" filter={`url(#${filterId})`} />
</svg>

<style>
  .grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: var(--grain-opacity);
    mix-blend-mode: overlay;
    pointer-events: none;
  }
</style>
