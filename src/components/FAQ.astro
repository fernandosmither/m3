---
import { faq } from "../data/m3";
---

<section class="faq" id="faq" aria-labelledby="faq-heading">
  <div class="shell faq__inner">
    <h2 class="faq__lead" id="faq-heading">{faq.lead}</h2>

    <div class="faq__list">
      {faq.items.map((item, i) => (
        <details class="faq__item" name="faq">
          <summary class="faq__summary">
            <span class="faq__index">({i + 1})</span>
            <span class="faq__question">{item.q}</span>
            <span class="faq__marker" aria-hidden="true">+</span>
          </summary>
          <div class="faq__answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Lets block-size animate to `auto` where supported (progressive). */
  :global(:root) {
    interpolate-size: allow-keywords;
  }

  .faq {
    border-block-start: 1px solid var(--hairline-soft);
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }

  .faq__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2.25rem, 5vw, 3.5rem);
  }

  .faq__lead {
    max-width: 38ch;
    font-size: var(--step-lead);
    line-height: 1.32;
  }

  .faq__item {
    border-block-start: 1px solid var(--hairline);
  }

  .faq__item:last-child {
    border-block-end: 1px solid var(--hairline);
  }

  .faq__summary {
    display: grid;
    grid-template-columns: 3.25rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(1.125rem, 2.5vw, 1.5rem);
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__summary:focus-visible {
    outline: 2px solid rgb(255 255 255 / 0.7);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .faq__index {
    color: var(--ink-dim);
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
  }

  .faq__question {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    transition: color 200ms ease;
  }

  .faq__summary:hover .faq__question {
    color: var(--ink);
  }

  .faq__marker {
    align-self: center;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 1rem;
    line-height: 1;
    transition: transform 260ms ease, color 200ms ease;
  }

  .faq__item[open] .faq__marker {
    transform: rotate(45deg);
    color: var(--ink);
  }

  .faq__answer {
    max-width: 62ch;
    padding-inline-start: calc(3.25rem + 1rem);
    padding-block-end: clamp(1.25rem, 2.5vw, 1.75rem);
    color: var(--ink-muted);
    line-height: 1.66;
  }

  .faq__item::details-content {
    opacity: 0;
    block-size: 0;
    overflow-y: clip;
    transition:
      content-visibility 300ms allow-discrete,
      opacity 300ms ease,
      block-size 300ms ease;
  }

  .faq__item[open]::details-content {
    opacity: 1;
    block-size: auto;
  }

  @media (max-width: 40rem) {
    .faq__summary {
      grid-template-columns: 2.25rem 1fr auto;
    }

    .faq__answer {
      padding-inline-start: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item::details-content,
    .faq__marker,
    .faq__question {
      transition: none;
    }
  }
</style>
