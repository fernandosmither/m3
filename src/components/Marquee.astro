---
import { readFileSync } from 'node:fs';
import { proof } from '../data/site';
import { proofLogos } from '../data/logos';

/**
 * Social proof strip: an infinite marquee drifting right to left, faded out at
 * both edges.
 *
 * The track holds three copies of the list and the flex container centres it,
 * so at rest the middle copy sits dead centre. Translating by exactly one third
 * of the track shifts it by one full copy, which makes the loop seamless with
 * no measuring and no JavaScript.
 */
interface Props {
  /** Seconds for one full copy to pass. Higher is slower. */
  duration?: number;
}

const { duration = 80 } = Astro.props;
const COPIES = 3;

/**
 * The site is served under a base path, so the logos need it prepended. Same
 * trick as the favicon in Base.astro: join, then collapse the double slash.
 */
const asset = (path: string) => `${import.meta.env.BASE_URL}/${path}`.replace(/\/+/g, '/');

/**
 * Intrinsic size of a logo, read from the file itself at build time.
 *
 * Same precedence the browser uses: a numeric width and height win, otherwise
 * the viewBox. Percentages are not a size, so they fall through.
 */
const px = (v?: string) => (v && !v.endsWith('%') ? Number.parseFloat(v) : NaN);

const size = (src: string) => {
  /* From the project root, not from here: at build time this module is a
     bundled chunk inside `dist`, so a relative path lands in the wrong tree. */
  const tag = readFileSync(`${process.cwd()}/public${src}`, 'utf8').match(/<svg[^>]*>/)?.[0] ?? '';
  const w = px(tag.match(/\bwidth="([^"]+)"/)?.[1]);
  const h = px(tag.match(/\bheight="([^"]+)"/)?.[1]);
  if (w > 0 && h > 0) return { w: Math.round(w), h: Math.round(h) };

  const box = tag.match(/\bviewBox="([^"]+)"/)?.[1].trim().split(/[\s,]+/).map(Number);
  return box?.length === 4 && box[2] > 0 && box[3] > 0
    ? { w: Math.round(box[2]), h: Math.round(box[3]) }
    : { w: 3, h: 1 };
};

const logos = proofLogos.map((logo) => ({ ...logo, ...size(logo.src) }));
---

{
  proofLogos.length > 0 && (
    <section class="proof" aria-label="Social proof">
      {proof.label && <p class="proof__label">{proof.label}</p>}

      <div class="proof__viewport">
        <ul class="proof__track" style={`--duration:${duration}s`}>
          {Array.from({ length: COPIES }).flatMap((_, copy) =>
            logos.map((logo) => (
              <li class="proof__item" aria-hidden={copy > 0 ? 'true' : undefined}>
                <img
                  src={asset(logo.src)}
                  alt={logo.alt}
                  /*
                   * The real size, so the box is reserved before the file
                   * arrives. Without it a lazy logo is zero wide until it
                   * loads: the track kept resizing under the animation, the
                   * three copies stopped matching, and the loop below, which
                   * assumes they are equal, jumped at every wrap.
                   */
                  width={logo.w}
                  height={logo.h}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))
          )}
        </ul>
      </div>
    </section>
  )
}

<style>
  .proof {
    position: relative;
    z-index: 2;
    padding-inline: var(--gutter);
  }

  .proof__label {
    margin: 0 0 clamp(0.75rem, 2vw, 1.25rem);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--footer-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c3);
    /* Always one line: it reads as a caption, not as a paragraph. */
    white-space: nowrap;
  }

  /*
   * On phones the line is wider than the screen at the normal size, so it
   * scales with the viewport instead of wrapping.
   */
  @media (max-width: 640px) {
    .proof__label {
      font-size: min(var(--footer-text), 2.7vw);
      letter-spacing: 0.03em;
    }
  }

  .proof__viewport {
    display: flex;
    /* Centres the track, so the middle copy starts dead centre. */
    justify-content: center;
    /*
     * A narrow band under the statement, not a full-bleed rail. Wider than the
     * old wordmark strip because logos are much wider than single words.
     */
    width: min(38rem, 100%);
    margin-inline: auto;
    overflow: hidden;
    /* Fades both edges into the background. */
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 22%,
      #000 78%,
      transparent 100%
    );
    mask-image: linear-gradient(90deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
  }

  .proof__track {
    display: flex;
    align-items: center;
    flex: none;
    width: max-content;
    gap: clamp(2rem, 4vw, 3rem);
    padding-inline: clamp(1rem, 2vw, 1.5rem);
    animation: drift var(--duration) linear infinite;
  }

  .proof__item {
    display: flex;
    align-items: center;
    flex: none;
  }

  /*
   * The artwork is drawn dark-on-light, so it is inverted to sit on the dark
   * background. The hue rotation puts the colours back where the inversion
   * moved them, and the opacity matches the weight the wordmarks used to have.
   */
  /* Tall enough that the crest-style marks stay legible, per aisb.dev. */
  .proof__item img {
    display: block;
    height: clamp(1.625rem, 2.5vw, 2.25rem);
    width: auto;
    object-fit: contain;
    filter: invert(1) hue-rotate(180deg);
    opacity: 0.72;
  }

  /* One third of the track is exactly one copy of the list. */
  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-33.3333%, 0, 0);
    }
  }

  /*
   * Pause on the strip itself, not on the section: the section spans the full
   * width, so hovering anywhere on that band used to stop it.
   */
  .proof__viewport:hover .proof__track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .proof__track {
      animation: none;
    }
  }
</style>
