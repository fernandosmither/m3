---
import { affiliations } from "../data/m3";
import AffiliationLogo from "./AffiliationLogo.astro";

/**
 * The track is duplicated once and translated by exactly -50%, so the loop is
 * seamless regardless of how many logos there are.
 */
const track = [...affiliations.logos];
const loop = [...track, ...track];
---

<section class="affil" aria-label="Past participant affiliations">
  <p class="eyebrow affil__label">{affiliations.label}</p>

  <div class="marquee">
    <ul class="marquee__track" aria-hidden="true">
      {loop.map((logo) => (
        <li class="marquee__item">
          <AffiliationLogo name={logo.name} file={logo.file} />
        </li>
      ))}
    </ul>
  </div>

  <p class="visually-hidden">{affiliations.logos.map((logo) => logo.name).join(", ")}</p>
</section>

<style>
  .affil {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-block-start: 1px solid var(--hairline-soft);
  }

  .affil__label {
    padding-inline: var(--gutter);
    text-align: center;
  }

  .marquee {
    width: 100%;
    overflow: hidden;
    /* Fades the logos into the page edges instead of cutting them hard. */
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }

  .marquee__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: clamp(2.5rem, 6vw, 5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    animation: marquee 80s linear infinite;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @keyframes marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
      justify-content: center;
      flex-wrap: wrap;
      width: 100%;
    }

    .marquee {
      mask-image: none;
    }
  }
</style>
