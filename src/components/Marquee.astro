---
import { proof } from '../data/site';

/**
 * Social proof strip: an infinite marquee drifting right to left, faded out at
 * both edges.
 *
 * The track holds three copies of the list and the flex container centres it,
 * so at rest the middle copy sits dead centre. Translating by exactly one third
 * of the track shifts it by one full copy, which makes the loop seamless with
 * no measuring and no JavaScript.
 */
interface Props {
  /** Seconds for one full copy to pass. Higher is slower. */
  duration?: number;
}

const { duration = 26 } = Astro.props;
const COPIES = 3;
---

{
  proof.logos.length > 0 && (
    <section class="proof" aria-label="Social proof">
      {proof.label && <p class="proof__label">{proof.label}</p>}

      <div class="proof__viewport">
        <ul class="proof__track" style={`--duration:${duration}s`}>
          {Array.from({ length: COPIES }).flatMap((_, copy) =>
            proof.logos.map((name) => (
              <li class="proof__item" aria-hidden={copy > 0 ? 'true' : undefined}>
                {name}
              </li>
            ))
          )}
        </ul>
      </div>
    </section>
  )
}

<style>
  .proof {
    position: relative;
    z-index: 2;
    padding-inline: var(--gutter);
  }

  .proof__label {
    margin: 0 0 clamp(0.75rem, 2vw, 1.25rem);
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--footer-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c3);
    /* Always one line: it reads as a caption, not as a paragraph. */
    white-space: nowrap;
  }

  /*
   * On phones the line is wider than the screen at the normal size, so it
   * scales with the viewport instead of wrapping.
   */
  @media (max-width: 640px) {
    .proof__label {
      font-size: min(var(--footer-text), 2.7vw);
      letter-spacing: 0.03em;
    }
  }

  .proof__viewport {
    display: flex;
    /* Centres the track, so the middle copy starts dead centre. */
    justify-content: center;
    /* A narrow band under the statement, not a full-bleed rail. */
    width: min(30rem, 100%);
    margin-inline: auto;
    overflow: hidden;
    /* Fades both edges into the background. */
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 22%,
      #000 78%,
      transparent 100%
    );
    mask-image: linear-gradient(90deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
  }

  .proof__track {
    display: flex;
    align-items: center;
    flex: none;
    width: max-content;
    gap: clamp(2rem, 4vw, 3rem);
    padding-inline: clamp(1rem, 2vw, 1.5rem);
    animation: drift var(--duration) linear infinite;
  }

  .proof__item {
    font-family: var(--font-sans);
    font-size: clamp(0.9375rem, calc(0.9375rem + 5 * var(--slope)), 1.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--ink);
    opacity: 0.72;
  }

  /* One third of the track is exactly one copy of the list. */
  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-33.3333%, 0, 0);
    }
  }

  /*
   * Pause on the strip itself, not on the section: the section spans the full
   * width, so hovering anywhere on that band used to stop it.
   */
  .proof__viewport:hover .proof__track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .proof__track {
      animation: none;
    }
  }
</style>
