---
/*
 * Overscroll navigation. Push past the bottom of a page and the next one takes
 * over; push past the top and you go back. Wheel and touch only: the nav pills
 * stay the accessible path, and keyboard or scrollbar scrolling is untouched.
 */
---

<div class="flow" aria-hidden="true">
  <p class="flow__label"><span class="flow__kind">NEXT</span> / <span class="flow__page"></span></p>
  <div class="flow__track"><div class="flow__fill"></div></div>
</div>

<script>
  const PAGES = ['/', '/program/', '/focus/'];
  const NAMES = ['M3', 'PROGRAM', 'FOCUS'];

  /** Wheel pixels that commit the move. Deliberate, not a flick. */
  const THRESHOLD = 620;
  /** Grace after the last push before the count starts falling back. */
  const IDLE = 150;
  /** A full bar empties in this long once the pushing stops. */
  const DRAIN = 600;
  /** Finger travel is capped by the screen, so touch counts triple. */
  const TOUCH_GAIN = 3;
  /** Quiet between wheel events that counts as the hand starting again. */
  const GAP = 120;
  /**
   * Slack at either end. Wide enough to cover the 6px the [data-rise] entrance
   * adds to the scroll height while it plays: without it the home page, which
   * otherwise never scrolls, ignores the first push after every load.
   */
  const EDGE = 8;

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  /** Seat of a path in the running order, or -1 if it is not one of ours. */
  const seat = (path: string) => {
    const rel = (path.startsWith(base) ? path.slice(base.length) : path) || '/';
    return PAGES.indexOf(rel.endsWith('/') ? rel : `${rel}/`);
  };

  const el = document.querySelector<HTMLElement>('.flow');
  const here = seat(location.pathname);

  if (el && here >= 0) {
    const kind = el.querySelector<HTMLElement>('.flow__kind')!;
    const page = el.querySelector<HTMLElement>('.flow__page')!;
    const doc = document.documentElement;

    let acc = 0; // pixels of intent banked at the edge
    let dir = 0; // 1 forward, -1 back, 0 idle
    let last = 0; // time of the last push
    let mark = 0; // previous frame, for the drain
    let raf = 0;
    let gone = false; // navigation fired: ignore everything after it

    /* The home page never scrolls, so both edges are true there. */
    const atEdge = (way: number) =>
      way > 0
        ? window.scrollY + window.innerHeight >= doc.scrollHeight - EDGE
        : window.scrollY <= EDGE;

    const show = () => {
      el.style.setProperty('--p', Math.min(acc / THRESHOLD, 1).toFixed(3));
    };

    const clear = () => {
      acc = 0;
      dir = 0;
      mark = 0;
      el.removeAttribute('data-dir');
      el.style.setProperty('--p', '0');
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    const loop = (now: number) => {
      raf = 0;
      const dt = mark ? now - mark : 16;
      mark = now;
      if (now - last > IDLE) acc -= (THRESHOLD / DRAIN) * dt;
      if (acc <= 0) {
        clear();
        return;
      }
      show();
      raf = requestAnimationFrame(loop);
    };

    /** One increment of intent, already normalised to pixels. */
    const push = (d: number) => {
      if (gone || !d) return;

      const way = d > 0 ? 1 : -1;
      const to = here + way;

      // No page that way, or this one still has room to scroll: no intent.
      if (to < 0 || to >= PAGES.length || !atEdge(way)) {
        if (dir) clear();
        return;
      }

      // Reversing restarts the count: the two edges never share progress.
      if (way !== dir) {
        acc = 0;
        dir = way;
        el.dataset.dir = way > 0 ? 'next' : 'prev';
        kind.textContent = way > 0 ? 'NEXT' : 'BACK';
        page.textContent = NAMES[to];
      }

      acc += Math.abs(d);
      last = performance.now();

      if (acc >= THRESHOLD) {
        gone = true;
        clear(); // the hint must not be in the outgoing snapshot
        location.assign(`${base}${PAGES[to]}`);
        return;
      }

      show();
      if (!raf) {
        mark = 0;
        raf = requestAnimationFrame(loop);
      }
    };

    let seen = 0; // time of the previous wheel event
    let spent = false; // that gesture already went into scrolling the page

    window.addEventListener(
      'wheel',
      (e) => {
        // deltaMode 1 is lines, 2 is pages; everything is counted in pixels.
        const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1;
        const d = e.deltaY * unit;
        if (!d) return;

        const now = performance.now();
        if (now - seen > GAP) spent = false;
        seen = now;

        /*
         * A gesture that was still scrolling the page cannot also commit the
         * move: trackpad momentum from a flick down a long page would arrive
         * at the bottom and carry you off it. Push again and it counts.
         */
        if (spent) return;
        if (!atEdge(d > 0 ? 1 : -1)) spent = true;

        push(d);
      },
      { passive: true }
    );

    let touch = 0;

    window.addEventListener(
      'touchstart',
      (e) => {
        touch = e.touches[0].clientY;
      },
      { passive: true }
    );

    window.addEventListener(
      'touchmove',
      (e) => {
        // Pinches are not a scroll gesture.
        if (e.touches.length > 1) return;
        const y = e.touches[0].clientY;
        const d = (touch - y) * TOUCH_GAIN;
        touch = y;
        if (!d) return;

        /*
         * At an edge with a page beyond it, the pull belongs to the flow. Left
         * to Safari, the same gesture rubber-bands — and at the top it starts
         * pull-to-refresh, which always outruns the hint.
         */
        const to = here + (d > 0 ? 1 : -1);
        if (!gone && to >= 0 && to < PAGES.length && atEdge(d > 0 ? 1 : -1) && e.cancelable) {
          e.preventDefault();
        }

        push(d);
      },
      { passive: false }
    );

    // Restored from the back/forward cache: lift the guard or the page is dead.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      gone = false;
      clear();
    });
  }

  /*
   * Direction of the cross-document view transition. Both documents have to
   * agree on the type, so each works it out from the pair of URLs rather than
   * from anything handed over.
   */
  const goingBack = (from: string, to: string) => {
    const a = seat(new URL(from).pathname);
    const b = seat(new URL(to).pathname);
    return a >= 0 && b >= 0 && b < a;
  };

  // Outgoing document: it is the one being left, so it is the `from`.
  window.addEventListener('pageswap', (e) => {
    const { viewTransition, activation } = e as any;
    const to = activation?.entry?.url;
    if (viewTransition && to && goingBack(location.href, to)) viewTransition.types?.add('flow-back');
  });

  // Incoming document.
  window.addEventListener('pagereveal', (e) => {
    const { viewTransition } = e as any;
    const from = (window as any).navigation?.activation?.from?.url;
    if (viewTransition && from && goingBack(from, location.href)) {
      viewTransition.types?.add('flow-back');
    }
  });
</script>

<style>
  .flow {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    pointer-events: none;
    /* Only the script ever shows this, and --p is how far along it is. */
    visibility: hidden;
    opacity: calc(0.3 + var(--p, 0) * 0.7);
    scale: calc(0.94 + var(--p, 0) * 0.06);
  }

  .flow[data-dir] {
    visibility: visible;
  }

  /* Clear of the footer line, which owns the bottom gutter. */
  .flow[data-dir='next'] {
    bottom: calc(var(--gutter) * 2.2);
  }

  /* Back reads upward, so the bar sits above the words: nearest the edge it
     points at. */
  .flow[data-dir='prev'] {
    top: calc(var(--gutter) * 1.2);
    flex-direction: column-reverse;
  }

  /* The chip carries its own scrim: it lands over the footer, the nav and the
     ASCII field, and has to stay legible on all three. */
  .flow__label {
    padding: 0.3rem 0.6rem;
    border-radius: 5px;
    background: var(--scrim-strong);
    color: var(--c1);
    font-family: var(--font-mono);
    font-size: var(--footer-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .flow__kind {
    color: var(--c3);
  }

  .flow__track {
    width: clamp(5rem, 20vw, 7.5rem);
    height: 2px;
    background: var(--c4);
  }

  .flow__fill {
    width: calc(var(--p, 0) * 100%);
    height: 100%;
    background: var(--c1);
  }

  /* Coarse mouse wheels arrive in chunks; the smoothing hides the steps. */
  @media not (prefers-reduced-motion: reduce) {
    .flow {
      transition:
        opacity 0.12s var(--ease),
        scale 0.12s var(--ease);
    }

    .flow__fill {
      transition: width 0.12s var(--ease);
    }
  }

  /* On phones the pills are centred and the footer stacks, both at the very
     edge, so the hint steps in past them instead of landing on top. */
  @media (max-width: 640px) {
    .flow[data-dir='next'] {
      bottom: calc(var(--gutter) + 3.25rem);
    }

    .flow[data-dir='prev'] {
      top: calc(var(--gutter) + 3.25rem);
    }
  }
</style>
