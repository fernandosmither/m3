---
import { lead, stats } from "../data/m3";
import Grain from "./Grain.astro";
---

<section class="lede">
  <div class="lede__bg" aria-hidden="true">
    <Grain filterId="stats-grain-filter" />
  </div>

  <div class="shell lede__inner">
    <p class="lede__text">{lead}</p>

    <dl class="stats">
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat__value">{s.value}</dt>
          <dd class="stat__unit">{s.unit}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .lede {
    position: relative;
    isolation: isolate;
    border-block-start: 1px solid var(--hairline-soft);
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
    background: var(--bg);
    overflow: hidden;
  }

  .lede__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .lede__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }

  .lede__text {
    max-width: 24ch;
    font-size: var(--step-lead);
    line-height: 1.28;
    letter-spacing: -0.008em;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.75rem, 4vw, 2.5rem);
    width: 100%;
    max-width: 52rem;
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .stat__value {
    font-family: var(--serif);
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat__unit {
    margin: 0;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: var(--step-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
