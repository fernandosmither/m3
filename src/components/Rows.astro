---
interface Props {
  sections: { n: string; title: string; paragraphs: string[] }[];
}

const { sections } = Astro.props;

/**
 * `[[phrase]]` in the copy renders highlighted. Splitting on the capture group
 * means the odd indices are exactly what sat inside the brackets.
 */
const split = (text: string) => text.split(/\[\[(.+?)\]\]/g);

/**
 * `[text](url)` renders as a link. Two capture groups, so of every three
 * indices the first is plain text, the second the label, the third the URL.
 */
const links = (text: string) => text.split(/\[(.+?)\]\((.+?)\)/g);
---

<div class="rows">
  {
    sections.map((s) => (
      <section class="row">
        <h2 class="row__head">
          <span class="row__n">{s.n}</span>
          <span class="row__title">{s.title}</span>
        </h2>
        <div class="row__body">
          {s.paragraphs.map((p) => (
            <p>
              {split(p).map((chunk, i) =>
                i % 2 ? (
                  <mark>{chunk}</mark>
                ) : (
                  links(chunk).map((part, j, parts) =>
                    j % 3 === 1 ? (
                      <a href={parts[j + 1]} target="_blank" rel="noopener">
                        {part}
                      </a>
                    ) : j % 3 === 2 ? null : (
                      part
                    )
                  )
                )
              )}
            </p>
          ))}
        </div>
      </section>
    ))
  }
</div>

<style>
  .rows {
    display: grid;
    gap: clamp(3.5rem, 9vw, 7rem);
    padding: clamp(3.5rem, 9vw, 7rem) var(--gutter);
  }

  .row {
    display: grid;
    gap: clamp(1.25rem, 4vw, 2.5rem);
  }

  .row__head {
    display: flex;
    align-items: flex-start;
    gap: 0.6em;
    font-family: var(--font-sans);
    font-size: var(--body-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .row__n {
    font-family: var(--font-mono);
    font-size: 0.5em;
    /* Aligns the (1) with the cap height, not the baseline. */
    padding-top: 0.35em;
    color: var(--c2);
  }

  /* Same colour pair as the text selection, so the highlight reads like
     someone ran a marker over it. */
  mark {
    background: var(--c1);
    color: #1a1a1a;
    padding: 0.04em 0.12em;
    margin-inline: -0.04em;
    border-radius: 2px;
  }

  /* Body links underline in the accent so they read apart from the marks. */
  .row__body a {
    text-decoration: underline;
    text-decoration-color: var(--c2);
    text-underline-offset: 0.15em;
    transition: color 0.25s var(--ease);
  }

  .row__body a:hover {
    color: var(--c2);
  }

  .row__body {
    display: grid;
    gap: 1em;
    font-family: var(--font-sans);
    font-size: var(--body-lg);
    font-weight: 400;
    line-height: 1.24;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .row__body {
      max-width: 22ch;
      /* Keep body copy in the right column. */
      min-width: 100%;
    }
  }
</style>
