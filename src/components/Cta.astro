---
import { site } from '../data/site';

/**
 * Closing call to action. The nav pill is always there, but the reader who
 * scrolled to the end of the journey should not have to travel back up for it.
 */
interface Props {
  /** Mono line above the button. */
  note: string;
}

const { note } = Astro.props;
---

<section class="cta">
  <p class="cta__note">{note}</p>
  <a class="cta__btn" href={site.applyUrl} target="_blank" rel="noopener">Apply</a>
</section>

<style>
  .cta {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    padding: clamp(1rem, 3vw, 2rem) var(--gutter) clamp(4rem, 10vw, 7rem);
    text-align: center;
  }

  .cta__note {
    font-family: var(--font-mono);
    font-size: var(--statement);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c2);
  }

  /* The nav's Apply pill at display scale: same tone, same dimming hover. */
  .cta__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.55em 1.3em;
    border-radius: 6px;
    background: var(--c1);
    color: var(--on-light);
    font-family: var(--font-sans);
    font-size: var(--body-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: opacity 0.25s var(--ease);
  }

  .cta__btn:hover {
    opacity: 0.78;
  }
</style>
