---
import { nav, site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => (href.startsWith('/') ? `${base}${href}/` : href);

const here = Astro.url.pathname.replace(/\/$/, '');
---

<header class="nav" data-rise>
  <ul class="nav__pills">
    <li class="nav__item">
      <a
        class="pill pill--brand"
        href={`${base}/`}
        aria-label={`${site.name}, ${site.longName}, home`}
      >
        {site.name}
      </a>
    </li>
    {
      nav.map((item) => (
        <li class="nav__item">
          <a
            class="pill"
            href={link(item.href)}
            style={`--pill-bg: var(--${item.tone})`}
            aria-current={here === `${base}${item.href}` ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<style>
  .nav {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    padding: var(--gutter);
  }

  .nav__pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* El guion conector vive en este hueco. */
    gap: 0.8125rem;
  }

  .nav__item {
    position: relative;
    display: flex;
  }

  /* Connector between navigation items. */
  .nav__item + .nav__item::before {
    content: '';
    position: absolute;
    left: -0.8125rem;
    top: 50%;
    width: 0.8125rem;
    height: 2px;
    margin-top: -1px;
    background: var(--c4);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    height: var(--pill-h);
    padding-inline: 0.75em;
    border-radius: 6px;
    background: var(--pill-bg, var(--c2));
    color: var(--on-light);
    font-family: var(--font-sans);
    font-size: var(--pill-text);
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: opacity 0.25s var(--ease);
  }

  .pill--brand {
    background: var(--c2);
  }

  /* Con varias pastillas ya en blanco, el hover baja opacidad en vez de
     cambiar de color: funciona igual sea cual sea el tono. */
  .pill:hover {
    opacity: 0.78;
  }

  /* La pagina actual se apaga: sigue legible pero deja de invitar al click. */
  .pill[aria-current='page'] {
    background: var(--c5);
    color: var(--ink);
  }

  /*
   * Sobre un panel de color, una pastilla del mismo tono desaparece. El
   * contorno las delimita siempre, y la marca se va al tono mas oscuro.
   */
  :global(.panel--light) .pill {
    box-shadow: inset 0 0 0 1px var(--c5);
  }

  :global(.panel--light) .pill--brand {
    background: var(--c5);
    color: var(--ink);
    box-shadow: none;
  }

  :global(.panel--light) .nav__item + .nav__item::before {
    background: var(--c5);
  }

  /* En pantallas chicas las pastillas se apilan y el guion estorba. */
  @media (max-width: 640px) {
    .nav__pills {
      gap: 0.375rem;
    }

    .nav__item + .nav__item::before {
      display: none;
    }
  }
</style>
