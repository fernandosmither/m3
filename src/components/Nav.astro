---
import { nav, site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (href: string) => (href.startsWith('/') ? `${base}${href}/` : href);

const here = Astro.url.pathname.replace(/\/$/, '');
---

<header class="nav" data-rise>
  <ul class="nav__pills">
    <li class="nav__item">
      <a
        class="pill pill--brand"
        href={`${base}/`}
        aria-label={`${site.name}, ${site.longName}, home`}
      >
        {site.name}
      </a>
    </li>
    {
      nav.map((item) => (
        <li class="nav__item">
          <a
            class="pill"
            href={link(item.href)}
            style={`--pill-bg: var(--${item.tone})`}
            aria-current={here === `${base}${item.href}` ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<style>
  .nav {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    padding: var(--gutter);
    /* Darkens the ASCII under the pills, fading out below them. */
    background: linear-gradient(
      180deg,
      var(--scrim-strong) 0%,
      var(--scrim-mid) 55%,
      var(--scrim-none) 100%
    );
    padding-bottom: calc(var(--gutter) * 2);
  }

  .nav__pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* The connector dash lives inside this gap. */
    gap: 0.625rem;
  }

  .nav__item {
    position: relative;
    display: flex;
  }

  /* Connector between navigation items. */
  .nav__item + .nav__item::before {
    content: '';
    position: absolute;
    left: -0.625rem;
    top: 50%;
    width: 0.625rem;
    height: 2px;
    margin-top: -1px;
    background: var(--c4);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    height: var(--pill-h);
    padding-inline: 0.75em;
    border-radius: 5px;
    background: var(--pill-bg, var(--c2));
    color: var(--on-light);
    font-family: var(--font-sans);
    font-size: var(--pill-text);
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: opacity 0.25s var(--ease);
  }

  .pill--brand {
    background: var(--c2);
  }

  /* Several pills are already white, so hover dims instead of changing
     colour: it works whatever the tone. */
  .pill:hover {
    opacity: 0.78;
  }

  /* The current page dims: still legible, no longer inviting a click. */
  .pill[aria-current='page'] {
    background: var(--c5);
    color: var(--ink);
  }

  /*
   * On a coloured panel, a pill in the same tone disappears. The outline always
   * delimits them, and the wordmark drops to the darkest tone.
   */
  :global(.panel--light) .pill {
    box-shadow: inset 0 0 0 1px var(--c5);
  }

  :global(.panel--light) .pill--brand {
    background: var(--c5);
    color: var(--ink);
    box-shadow: none;
  }

  :global(.panel--light) .nav__item + .nav__item::before {
    background: var(--c5);
  }

  /* On small screens the pills wrap and the dash gets in the way. */
  @media (max-width: 640px) {
    .nav__pills {
      gap: 0.375rem;
    }

    .nav__item + .nav__item::before {
      display: none;
    }
  }
</style>
